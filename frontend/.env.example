# Optional. Copy to .env.local to override.
# By default the frontend reuses GOOGLE_CLIENT_ID from backend/.env (it is a public value).
# In Google Cloud Console add http://localhost:5173 under "Authorized JavaScript origins".
# VITE_GOOGLE_CLIENT_ID=

# Only needed when the API is on a different domain (production). Dev uses the Vite proxy.
# VITE_API_URL=https://api.example.com/api
